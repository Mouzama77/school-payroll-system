# App settings
APP_NAME=School Payroll Management System
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-secure-secret-key

# Database settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_payroll_db

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=60
ALGORITHM=HS256

# OTP-based password reset
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESET_TOKEN_EXPIRE_MINUTES=10

# SMTP / email settings
# Leave EMAIL_DEV_MODE=true to log OTP emails to the console (no SMTP needed).
# Set EMAIL_DEV_MODE=false and fill SMTP_* to send real emails.
EMAIL_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=no-reply@schoolpayroll.local
EMAIL_FROM_NAME=School Payroll System

# Example Gmail configuration (use an App Password, not your account password):
# EMAIL_DEV_MODE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=youraddress@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_USE_TLS=true
# EMAIL_FROM=youraddress@gmail.com
